# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic (used as automatic failover if OpenAI errors/times out)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-20241022

# Provider routing: order to try providers in (first is primary)
PRIMARY_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=anthropic

# LangSmith (optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=knowledge-assistant

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# CORS: comma-separated list of trusted browser origins allowed to call the
# API with credentials. Leave empty to allow none (server-to-server clients,
# like the Streamlit app, are unaffected — CORS only applies to browsers).
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Database (defaults below match the single-container deployment; override for local/dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_db

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Redis
REDIS_URL=redis://localhost:6379/0
